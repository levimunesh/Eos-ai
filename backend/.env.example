# Runtime connection as the restricted eos_app role (RLS applies).
# Supabase: use the session pooler host from Project Settings > Database, with user
# "eos_app.<project-ref>" and the password you set via: ALTER ROLE eos_app WITH PASSWORD '...';
DATABASE_URL=postgresql+asyncpg://eos_app:eos_app_dev@localhost:5432/eos

# Owner connection, used only by Alembic migrations.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eos

# Supabase Auth. Tokens signed with asymmetric keys are verified via JWKS from SUPABASE_URL.
SUPABASE_URL=https://<project-ref>.supabase.co
# Only for projects still on the legacy HS256 JWT secret. Leave empty otherwise.
SUPABASE_JWT_SECRET=

# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173"]
