# Supabase project URL, e.g. https://abcd1234.supabase.co
VITE_SUPABASE_URL=
# Supabase publishable (anon) key. Safe for the browser; never put a service-role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
# EOS AI backend base URL (optional; this is the default)
VITE_API_URL=http://localhost:8000/api/v1
